<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:node="remove" />

    <!--
        Without QUERY_ALL_PACKAGES, package-visibility filtering (targetSdk 30+)
        would hide every other app from the firewall / app-exclusion / app-privacy
        screens. Declare visibility of all launchable apps so those screens still
        enumerate the user's installed apps (system apps without a launcher may be
        absent — the known Play tradeoff).
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
        </intent>
    </queries>
</manifest>
