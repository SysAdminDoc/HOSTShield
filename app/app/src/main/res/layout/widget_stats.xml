<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/stats_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/stats_widget_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/widget_stats_title"
        android:textColor="#7FFFEA"
        android:textSize="11sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/stats_widget_blocked"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/widget_zero"
        android:textColor="#FF7AA8"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/stats_widget_blocked_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/widget_blocked_today"
        android:textColor="#D9E2F2"
        android:textSize="10sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/stats_widget_queries"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_zero"
                android:textColor="#9ED0FF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_queries"
                android:textColor="#AAB6C8"
                android:textSize="9sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/stats_widget_rate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_zero_percent"
                android:textColor="#7FFFEA"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_block_rate"
                android:textColor="#AAB6C8"
                android:textSize="9sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
