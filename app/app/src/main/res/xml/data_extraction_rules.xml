<?xml version="1.0" encoding="utf-8"?>
<!-- Disable cloud backup of all app data to prevent leaking
     blocklists, DNS logs, WireGuard keys, and credentials. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="." />
        <include domain="database" path="." />
    </device-transfer>
</data-extraction-rules>
