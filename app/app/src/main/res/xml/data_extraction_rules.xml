<?xml version="1.0" encoding="utf-8"?>
<!--
    Cloud backup: fully disabled. Avoids leaking blocklists, DNS logs,
    WireGuard keys, and credentials to Google Drive.

    Device transfer: include user-visible state (DataStore prefs, Room DB),
    BUT exclude Android Keystore-wrapped secure-store files.
    Their value ciphertexts are tied to the source device's hardware-backed
    master key — copying them to a new device produces unrecoverable bytes
    and locks the user out of WireGuard / WebDAV / parental PIN until they
    re-enter the credentials. Forcing re-entry is the safer default.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="." />
        <include domain="database" path="." />
        <!-- App settings live in Preferences DataStore (domain "file"). Once any
             include is present only listed files transfer, so this must be
             included explicitly or every preference resets to default after a
             device transfer. -->
        <include domain="file" path="datastore/hostshield_prefs.preferences_pb" />
        <exclude domain="sharedpref" path="hostshield_secure_prefs.xml" />
        <exclude domain="sharedpref" path="hostshield_secure_prefs" />
        <exclude domain="sharedpref" path="hostshield_secure_store_v2.xml" />
        <exclude domain="sharedpref" path="hostshield_secure_store_v2" />
    </device-transfer>
</data-extraction-rules>
